    {
      "id": "iii1-cecilias-treat",
      "lemma": "Cecilia's treat",
      "kind": "allusion",
      "text": "此处同 pick up Galen 连写。医学院地点与乔伊斯就学经历须另据生平资料核实；原著本身不能证明。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "iii1-jon-jacobsen",
      "lemma": "Jon Jacobsen",
      "kind": "wordplay",
      "text": "此名同 swigged a slug 相连，因而译文保留饮酒动作。威士忌品牌与丹麦作家的双指待核，暂不坐实异教文学寓意。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "iii1-flannelfeet",
      "lemma": "Flannelfeet",
      "kind": "wordplay",
      "text": "列在一串辱骂中，可按 flannel、feet 的字面试译「法兰绒足」。俚语义与谢姆具体行动均待核，不添阴谋情节。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    }
  ],
