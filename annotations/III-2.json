    {
      "id": "fw-iii2-442-01-n03",
      "lemma": "Tiger Roma",
      "kind": "allusion",
      "text": "原文把它列作 mottob，随后继续惩戒威胁。旧注指定漫画 Tiger Tim，未有外证，暂撤对应。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-442-01-n04",
      "lemma": "calorrubordolor",
      "kind": "wordplay",
      "text": "可按 calor、rubor、dolor 试听热、红、痛，紧随身体惩戒威胁。医学史分类与拉丁语源仍待外核。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-442-01-n05",
      "lemma": "Fred Wetherly",
      "kind": "allusion",
      "text": "原文称其为 homerole poet，并说他表达得更好。人物生卒年与《丹尼男孩》作品联系待核，暂不作传记断言。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-442-01-n06",
      "lemma": "Liffalidebankum",
      "kind": "wordplay",
      "text": "字形可见 Liff、bank，正文试留利菲河岸语感。爱丽丝仙境的对应未证，撤回。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    }
  ],
  "fw-iii2-446-01": [
    {
      "id": "fw-iii2-446-01-n01",
      "lemma": "Sevenheavens",
      "kind": "allusion",
      "text": "seven 与 heavens 连成感叹，后面重复 O heaven。译文保留七重天呼喊；犹太教、伊斯兰教宇宙论的具体对应未核。",
