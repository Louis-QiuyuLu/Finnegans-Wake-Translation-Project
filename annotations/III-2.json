    {
      "id": "fw-iii2-446-01-n02",
      "lemma": "Amberhann",
      "kind": "wordplay",
      "text": "地名紧接 sands，字首可见 amber。正文保留拟音；香农河与特定西海岸沙洲之说待核。",
      "source_ids": [
        "joyce-fp"
