{
  "fw-iii2-429-01": [
    {
      "id": "fw-iii2-429-01-n01",
      "lemma": "Jaunty Jaun",
      "kind": "wordplay",
      "text": "原文以这组头韵开章，继承前章 Shaun 的声音并改写人名。译作若昂，未据此固定为唐璜或传教士。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "proposal"
    },
    {
      "id": "fw-iii2-429-01-n02",
      "lemma": "cothurminous",
      "kind": "wordplay",
      "text": "此词修饰夜行第一程的 leg。译文试留高底靴语感；希腊语 cothurnus 与其他词的复合链尚待词典核查。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-429-01-n03",
      "lemma": "Lazar's Walk",
      "kind": "culture",
      "text": "原文把堤堰设在此地名旁。旧注指定汤森街及麻风院史，尚无外证，暂不采作定论。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-429-01-n04",
      "lemma": "holy januarious",
      "kind": "allusion",
      "text": "这是若昂脚麻描写中的誓语。旧注列圣雅纳略、血液化与雅努斯，均未另核，暂不带入正文因果。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-429-01-n05",
      "lemma": "buttoncups",
      "kind": "wordplay",
      "text": "字形交织 button 与 cup，亦近 buttercup。正文试作纽扣茶杯，保留衣饰与餐具的错位，花名一层未尽。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "proposal"
    },
    {
      "id": "fw-iii2-429-01-n06",
      "lemma": "swithin",
      "kind": "allusion",
      "text": "与给 medlard apples 命名相连。圣斯威辛节期与四十日雨俗尚待核，不能凭原文定为节日气象预言。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    }
  ],
  "fw-iii2-434-01": [
    {
      "id": "fw-iii2-434-01-n01",
      "lemma": "Bessy Sudlow",
      "kind": "allusion",
      "text": "人名连着 breeches parts、pantos，原文确有反串与舞台衣装语境；演员生平与婚配关系待核。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-434-01-n02",
      "lemma": "Harlotte Quai",
      "kind": "wordplay",
      "text": "可见 harlot 与 quay 的叠形，邻句明确叙述送葬。具体对应夏洛特码头与人物身世待核。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-434-01-n03",
      "lemma": "Marie Maudlin",
      "kind": "wordplay",
      "text": "人名同 feast 连用，可听 maudlin 的伤感语气。抹大拉玛利亚及具体瞻礼的对应待核，正文未据此确定历日。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-434-01-n04",
      "lemma": "Scenta Clauthes",
      "kind": "wordplay",
      "text": "可听 Santa Claus，又近 scent、clothes。长袜与心被塞满 temptiness，译文保留礼物与诱惑的混杂；语源链属试读。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "proposal"
    },
    {
      "id": "fw-iii2-434-01-n05",
      "lemma": "twelffinger bowel",
      "kind": "wordplay",
      "text": "按字面是十二指的肠，正文试作十二指肠。德语直译之说尚未查词典；保留医学词汇闯入训辞的突兀。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-434-01-n06",
      "lemma": "olt Pannonia",
      "kind": "allusion",
      "text": "原文写来客来自此地。古罗马行省范围与现代地名对应尚待外核，不能坐实来客国籍或教师身分。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    }
  ],
  "fw-iii2-438-01": [
    {
      "id": "fw-iii2-438-01-n01",
      "lemma": "malbongusta",
      "kind": "wordplay",
      "text": "括号紧随接吻描写，后面自释为 it’s not the thing。正文按不雅理解；世界语词源待核，不以未查词典的拆词作定论。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-438-01-n02",
      "lemma": "Peter Paragraph",
      "kind": "allusion",
      "text": "与 Paulus Puff 并列，二人明列在 presswritten epics 的写作者中。富特剧作的具体出处未核，暂不列人物起源。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-438-01-n03",
      "lemma": "rose marine",
      "kind": "wordplay",
      "text": "此处与 wish、lunchlight、eye 连写。迷迭香是试读；贞洁与永恒纪念的象征谱系待核，不限定为少女美德。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-438-01-n04",
      "lemma": "rollingpin",
      "kind": "culture",
      "text": "字面擀面杖，与 pie 同句。正文保留器物，民俗中悍妇武器一说未核，不借此另加情节。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "proposal"
    },
    {
      "id": "fw-iii2-438-01-n05",
      "lemma": "Brahaam's ass",
      "kind": "allusion",
      "text": "字形近 Abraham，又有 ass。巴兰的典故可能参与，但须核《民数记》与相关研究，暂保留人名叠合，不径改成巴兰。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-438-01-n06",
      "lemma": "saxopeeler",
      "kind": "wordplay",
      "text": "此词夹在剥皮般的咒骂中。Saxon、peeler 的叠合属试读，罗伯特·皮尔警队史待核。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    }
  ],
  "fw-iii2-442-01": [
    {
      "id": "fw-iii2-442-01-n01",
      "lemma": "black fremdling",
      "kind": "wordplay",
      "text": "由 black 与异文状 fremdling 连写，后句明称国家的敌人。德语来源与爱尔兰传统敌称待核，不据此确定肤色或民族。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
    },
    {
      "id": "fw-iii2-442-01-n02",
      "lemma": "Kerribrasilian sea",
      "kind": "allusion",
      "text": "字形可见 Kerry、Brasil、Brazil 的近似，正文保留合成地名；海-巴西尔传说的具体关联待核。",
      "source_ids": [
        "joyce-fp"
      ],
      "certainty": "uncertain"
