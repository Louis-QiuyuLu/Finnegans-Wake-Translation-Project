      "lemma": "Cunstuntonopolies",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "字形近Constantinople，旁句写Eonochs与manmade。可保留阉人与城名读路；cunning层及后宫史未证，不添具体制度。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-meschiameschianah",
      "lemma": "Meschiameschianah",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "此串名紧接琴师宣告与win a gain，正文保留拟音。玛什亚夫妇及琐罗亚斯德教始祖说须宗教原典或研究补证，不只引本书担保。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-perseoroyal",
      "lemma": "Perseoroyal",
      "kind": "wordplay",
      "certainty": "uncertain",
      "text": "Perseoroyal可试听Persian royal、Perseus，原文又写flying，译文以旗号试读。王室与英雄关系未证，不裁唯一读法。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-fenegans",
      "lemma": "Fenegans",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "Fenegans可与Finnegan比较，后接Wick与Wildemanns。守灵、灯芯、周次与地名等读路尚有余地，不说已指明一场现实聚会。",
      "source_ids": [
        "joyce-fp"
      ]
    }
  ],
  "fw-ii3-363-01": [
    {
      "id": "ii3-almayne",
      "lemma": "Almayne",
      "kind": "wordplay",
      "certainty": "uncertain",
      "text": "Almayne可与Allemagne、all mine比较，原文称Deductive Almayne Rogers。具体国籍与“全归我”词义仍是候选，不将其确定为某职业侦探。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-missaunderstaid",
      "lemma": "Missaunderstaid",
      "kind": "wordplay",
      "certainty": "uncertain",
      "text": "可把Miss、understood、staid并听，正文保留误解与小姐姿态。老处女性身份未由字串证明。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-kinahaun",
      "lemma": "Kinahaun",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "原文说be asservent to Kinahaun，译文保留人名。都柏林威士忌商的家族、品牌及厂址均未外核，暂撤确定商史。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-registower",
      "lemma": "Registower",
      "kind": "wordplay",
      "certainty": "uncertain",
      "text": "Registower近Registrar、tower，旁有tribute、city与hall。可留登记与塔的声形，不确定是哪座都柏林官署。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-bacchulus",
      "lemma": "Bacchulus",
      "kind": "wordplay",
      "certainty": "uncertain",
      "text": "Bacchulus可与Bacchus、baculus、bacillus或bachelor作形近比较。各语言词义尚待词典；正文不因这些联想新增神话故事。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-tunpother",
      "lemma": "Tunpother",
      "kind": "wordplay",
      "certainty": "uncertain",
      "text": "tun、pother是可比较的组成；附近有prison和plotch。正文以桶与喧嚣试读，不能据此扩写酒客全套动作。",
      "source_ids": [
        "joyce-fp"
      ]
    }
  ],
  "fw-ii3-369-01": [
    {
      "id": "ii3-brunos",
      "lemma": "Bruno's",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "Bruno’s出现在地址St. Bruno’s Toboggan Drive。可供布鲁诺研究，但不能据单个姓氏断言全书思想系统或此处所指哲学家。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-bellchimbers",
      "lemma": "Bellchimbers",
      "kind": "wordplay",
      "certainty": "uncertain",
      "text": "Bellchimbers可与bell、chamber比较，列在地址清单。常见姓氏和打烊钟声的确定归属尚无名录、文本证据。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-carolan",
      "lemma": "Carolan",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "Carolan是地址Carolan Crescent的一部分。音乐家O’Carolan可作候选，生平、盲人身份及具体互文待外证。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-dieudonney",
      "lemma": "Dieudonney",
      "kind": "wordplay",
      "certainty": "uncertain",
      "text": "Dieudonney近Dieudonné，属姓名清单。法语神赐词义与都柏林街坊身份须各自核证，不以人名样式确认籍贯。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-pandoria",
      "lemma": "Pandoria",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "Pandoria可与Pandora比较，后接Paullabucca及秘书鸟。Dorian柱式、灾厄之盒等链条未列资料，现不作已证典故。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-paullabucca",
      "lemma": "Paullabucca",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "Paullabucca可与Poulaphouca比较。具体瀑布、地名盖尔语原形和“恶魔之潭”词源均待地名资料。",
      "source_ids": [
        "joyce-fp"
      ]
    }
  ],
  "fw-ii3-376-01": [
    {
      "id": "ii3-roderick-oconor",
      "lemma": "Roderick O'Conor",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "原文明称Roderick O’Conor与最后的“前电气”爱尔兰国王，且随即反复修正“最后”的说法。历史王朝年代与他等同HCE的解释待外证，不能把笑谈当史实。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-obryan-macbruiser",
      "lemma": "O'Bryan MacBruiser",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "O’Bryan、MacBruiser与bet Norris Nobnut相连，可保留击打、拳赛和名字的读路。布赖恩·博鲁、克隆塔夫及维京战争的具体映射未核。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-clontarf",
      "lemma": "Clontarf",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "原文是Clontarf voterloost，已兼有Waterloo式声音。1014战役及爱尔兰民族史论须另引史料，正文不预设所影射者就是唯一一场战役。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-hymernians",
      "lemma": "Hymernians",
      "kind": "wordplay",
      "certainty": "uncertain",
      "text": "Hymernians可把Hibernians与Hymen比较，周围又有婚晨与敲门。神名来源与“古称”的沿用史待核，不把声音组合直接列成词源。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-maccormick",
      "lemma": "MacCormick",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "MacCormick处于长串Mac-名字中，可试听McCormack。歌唱家John McCormack的生平及统领演唱语境之说未获此注来源支持。",
      "source_ids": [
        "joyce-fp"
      ]
    },
    {
      "id": "ii3-clanruckard",
      "lemma": "Clanruckard",
      "kind": "allusion",
      "certainty": "uncertain",
      "text": "原文以Clanruckard for ever欢呼。Clanricarde伯爵名称可供后续核查，省份、家族血统与爵位史未在本轮查阅。",
      "source_ids": [
        "joyce-fp"
      ]
    }
  ]
